# Copy to .env and fill in. Never commit .env or any key file.
# Every service reads these from the environment; nothing is hard-coded.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# mock = no GCP credentials needed: Gemini -> rule-based fake, BigQuery -> JSON fixtures,
#        Firestore / Pub/Sub -> local emulators.
# gcp  = real Google Cloud services.
TRUSTSHIELD_MODE=mock

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=qualified-sun-511214-t1
GCP_REGION=asia-south1

# Gemini models (Vertex AI). Fast = live payment path, Pro = investigator / case summaries.
# Verified by a live call in asia-south1 on 13 Oct 2026. gemini-3.8-flash is NOT served in asia-south1
# for this project (404) and is ~4 s on the global endpoint, too slow for the payment path.
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Pro models are not served in asia-south1 for this project; the investigator (off the hot path)
# calls them on the global endpoint (~3-5 s).
GEMINI_PRO_LOCATION=global
# Per-call Gemini timeout on the live payment path; on timeout the agents fall back to rules.
GEMINI_TIMEOUT_MS=2500
# Thinking tokens for the live-path model. 0 = off (~1 s per call instead of ~4 s on 2.5 Flash).
GEMINI_FAST_THINKING_BUDGET=0
# Customer message on the live path: template (default, fast) or llm (Gemini, adds ~1 s).
GEMINI_CUSTOMER_MESSAGE=template
# --- Gemini within standard pay-as-you-go capacity (no Provisioned Throughput, no quota requests).
# gemini-2.5-flash uses capacity shared by all customers: a 429 means "busy", so we pace, retry
# with backoff, and try the fallback location (same price). All inside GEMINI_TIMEOUT_MS.
GEMINI_FALLBACK_LOCATION=global    # empty = regional only
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_QPS=4                   # local pacing so we never send bursts
GEMINI_CACHE_TTL_S=600             # identical messages reuse the last verdict; 0 = off

# ADK / google-genai read these to route Gemini calls through Vertex AI (gcp mode only).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=${GCP_PROJECT_ID}
GOOGLE_CLOUD_LOCATION=${GCP_REGION}

# Only if you are NOT using `gcloud auth application-default login`. Keep the file outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/key.json

# Vertex AI Search data store with the policy documents (Evidence & Policy agent, gcp mode).
VERTEX_SEARCH_DATASTORE_ID=
VERTEX_SEARCH_LOCATION=global   # Vertex AI Search data stores live in global/us/eu, not asia-south1

# BigQuery dataset holding the feature views (Ronak).
BQ_DATASET=trustshield

# Cloud Storage buckets (created by Hitesh on 13 Oct; datasets bucket still to create).
GCS_UPLOADS_BUCKET=qualified-sun-511214-t1-uploads
GCS_POLICY_DOCS_BUCKET=qualified-sun-511214-t1-policies
GCS_DATASETS_BUCKET=qualified-sun-511214-t1-datasets

# ---------------------------------------------------------------------------
# Local emulators (mock mode). Need Java 21+ and Firebase CLI. If 8080 is taken locally,
# change the port in firebase.json and here.
# ---------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=localhost:8080
PUBSUB_EMULATOR_HOST=localhost:8085

# ---------------------------------------------------------------------------
# Agents service (services/agents)
# ---------------------------------------------------------------------------
# Organisation whose risk weights / thresholds override the defaults in config/risk.yaml.
TRUSTSHIELD_ORG_ID=default
# Optional: path to an alternative risk config file.
TRUSTSHIELD_RISK_CONFIG=
# Feature store backend: json (data/mock/features.json, default in both modes) or bigquery
# (Ronak's feature views; adapter is a stub until they exist).
TRUSTSHIELD_FEATURE_STORE=json
# Optional: root folder containing config/, prompts/ and data/ (defaults to services/agents).
TRUSTSHIELD_AGENTS_HOME=
# Optional: alternative folder for the shared demo fixtures (defaults to shared/contracts/fixtures).
TRUSTSHIELD_FIXTURES_DIR=

# ---------------------------------------------------------------------------
# Gateway (services/gateway, Hitesh)
# ---------------------------------------------------------------------------
GATEWAY_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Web (web/, Sameer). Vite only exposes variables prefixed with VITE_.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

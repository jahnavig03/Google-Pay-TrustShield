{
  "name": "trustshield-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TrustShield prototype simulator (synthetic data): /pay, /analyst, /merchant.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && tsc -b --noEmit",
    "gen:api": "openapi-typescript ../shared/contracts/openapi.json -o src/api/schema.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "jsqr": "^1.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}

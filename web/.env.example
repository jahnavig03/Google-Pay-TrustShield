# Gateway base URL. Local: the FastAPI gateway; deployed: the Cloud Run URL.
VITE_API_BASE_URL=http://localhost:8000

# Demo sign-in for the analyst console (NOT security: VITE_* values are visible in the browser).
VITE_ANALYST_ACCESS_CODE=trustshield-demo

# Risk bands drawn on the analyst risk meter (display only; agents' config/risk.yaml decides).
VITE_RISK_WARN=0.35
VITE_RISK_STEP_UP=0.70
VITE_RISK_HOLD=0.90
